{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Falinks evaluation run evidence v1",
  "type": "object",
  "required": ["schema_version", "run_id", "arm", "fixture", "fixture_version", "freeze", "configuration", "order", "pair", "scored", "outcome", "usage", "usage_limit_interruptions", "rejected_operations", "retries", "discarded_or_rewritten_work", "validation_attempts", "recommendations", "transitions", "timing", "tool_differences", "harness_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "arm": {"enum": ["git", "falinks"]},
    "fixture": {"enum": ["rust-errors", "go-page", "go-relationships"]},
    "fixture_version": {"type": "integer", "minimum": 1},
    "freeze": {"type": "object"},
    "configuration": {"type": "object"},
    "order": {"type": "integer"},
    "pair": {"type": "string"},
    "scored": {"type": "boolean"},
    "outcome": {"enum": ["success", "task_failure", "timeout", "infrastructure_failure", "usage_limit", "safety_failure"]},
    "usage": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["available", "partial", "unavailable"]}}},
    "usage_limit_interruptions": {"type": "array"},
    "rejected_operations": {"type": ["integer", "object"]},
    "retries": {"type": ["integer", "object"]},
    "discarded_or_rewritten_work": {"type": "object"},
    "validation_attempts": {"type": "array", "items": {"type": "object", "required": ["number", "candidate", "passed", "conflict"]}},
    "recommendations": {"type": "integer", "minimum": 0},
    "transitions": {"type": "integer", "minimum": 0},
    "regrouping": {"type": "object", "description": "Falinks arm only (#134 Measurement); transitions equals the top-level field",
      "required": ["proposals", "agreements", "declines", "blocked", "transitions", "regrouping_handles", "regrouping_round_trips"],
      "properties": {
        "proposals": {"type": "object", "description": "Proposal count by action (Join, Split, Keep), then by proposer (engine, agent-0, agent-1)",
          "additionalProperties": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}},
        "agreements": {"type": "integer", "minimum": 0, "description": "Agree responses recorded across all proposals"},
        "declines": {"type": "integer", "minimum": 0},
        "blocked": {"type": "array", "description": "Proposals that were ever Blocked, with every blocker",
          "items": {"type": "object", "required": ["proposal", "blockers"], "properties": {"proposal": {"type": "string"}, "blockers": {"type": "array", "items": {"type": "string"}}}}},
        "transitions": {"type": "integer", "minimum": 0},
        "regrouping_handles": {"type": "integer", "minimum": 0, "description": "Accepted falinks_handle calls that covered or cleared a Regrouping event"},
        "regrouping_round_trips": {"type": "integer", "minimum": 0, "description": "Model round-trips (distinct assistant message ids) containing recommend, propose or respond"}
      }},
    "timing": {"type": "object", "required": ["start_utc", "stop_utc", "elapsed_seconds", "endpoint"]},
    "tool_differences": {"type": "object"},
    "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initial_snapshot": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_snapshot": {"type": ["string", "null"]},
    "oracle": {"type": ["object", "null"]},
    "failure_reason": {"type": "string"},
    "replaces": {"type": "string", "description": "Run ID of the infrastructure failure this run replaces"},
    "concurrency": {"type": "object", "description": "Run IDs active in sibling shard batch directories when this run started and stopped",
      "properties": {"start": {"type": "array", "items": {"type": "string"}}, "stop": {"type": "array", "items": {"type": "string"}}}}
  }
}
