{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Falinks evaluation run evidence v1",
  "type": "object",
  "required": ["schema_version", "run_id", "arm", "fixture", "fixture_version", "freeze", "configuration", "order", "pair", "scored", "outcome", "usage", "usage_limit_interruptions", "rejected_operations", "retries", "discarded_or_rewritten_work", "validation_attempts", "recommendations", "transitions", "timing", "tool_differences", "harness_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "arm": {"enum": ["git", "falinks"]},
    "fixture": {"enum": ["rust-errors", "go-page", "go-relationships"]},
    "fixture_version": {"type": "integer", "minimum": 1},
    "freeze": {"type": "object"},
    "configuration": {"type": "object"},
    "order": {"type": "integer"},
    "pair": {"type": "string"},
    "scored": {"type": "boolean"},
    "outcome": {"enum": ["success", "task_failure", "timeout", "infrastructure_failure", "usage_limit", "safety_failure"]},
    "usage": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["available", "partial", "unavailable"]}}},
    "usage_limit_interruptions": {"type": "array"},
    "rejected_operations": {"type": ["integer", "object"]},
    "retries": {"type": ["integer", "object"]},
    "discarded_or_rewritten_work": {"type": "object"},
    "validation_attempts": {"type": "array", "items": {"type": "object", "required": ["number", "candidate", "passed", "conflict"]}},
    "recommendations": {"type": "integer", "minimum": 0},
    "transitions": {"type": "integer", "minimum": 0},
    "timing": {"type": "object", "required": ["start_utc", "stop_utc", "elapsed_seconds", "endpoint"]},
    "tool_differences": {"type": "object"},
    "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initial_snapshot": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "final_snapshot": {"type": ["string", "null"]},
    "oracle": {"type": ["object", "null"]},
    "failure_reason": {"type": "string"},
    "replaces": {"type": "string", "description": "Run ID of the infrastructure failure this run replaces"}
  }
}
